# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="mysql://user:password@localhost:3306/mechanic_workshop"

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Administrador inicial (obligatorio en producción; opcional en desarrollo)
ADMIN_EMAIL=admin@workshop.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME="System Administrator"

# Upload
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Cloudinary (obligatorio cuando STORAGE_PROVIDER=cloudinary; solo en el backend)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=

# CORS
CORS_ORIGIN=http://localhost:5173
