{
  "name": "mechanic-workshop-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:check:prod": "tsx scripts/check-aiven.ts",
    "db:migrate:aiven": "node scripts/run-aiven.mjs migrate",
    "db:status:aiven": "node scripts/run-aiven.mjs status",
    "db:seed:aiven": "node scripts/run-aiven.mjs seed",
    "db:verify:aiven": "node scripts/run-aiven.mjs verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:storage": "tsx scripts/check-cloudinary.ts",
    "test:admin-guard": "node scripts/check-admin-self-protection.cjs"
  },
  "keywords": [
    "mechanic",
    "workshop",
    "management"
  ],
  "author": "Andrey Macias",
  "license": "ISC",
  "description": "API for Mechanic Workshop Management System",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0"
  }
}
