# Preparación local del despliegue. No contiene credenciales reales.
NODE_ENV=production
PORT=3000

# Pegar la contraseña de Aiven entre las comillas. db:check:prod genera DATABASE_URL.
AIVEN_HOST=your-service.f.aivencloud.com
AIVEN_PORT=your-port
AIVEN_USER=avnadmin
AIVEN_DATABASE=defaultdb
AIVEN_PASSWORD=""
DATABASE_URL=""

# Secretos exclusivos del destino; utilizar valores aleatorios.
JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-another-random-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Administrador inicial: el seed de producción requiere correo y contraseña propios.
ADMIN_EMAIL=admin@workshop.com
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_FULL_NAME="Administrador del sistema"

STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=""
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Sustituir por la dirección del frontend antes del despliegue.
CORS_ORIGIN=http://localhost:5173
