{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  // Incluye src además de tests porque los tests importan los módulos que
  // prueban. Es un proyecto aparte, no referenciado desde tsconfig.json: el
  // `npm run build` sigue comprobando solo la aplicación, y los tipos de los
  // tests se revisan con `npm run test:types`.
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "vitest.config.ts"]
}
